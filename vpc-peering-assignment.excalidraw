      "updated": 1756949617770,
      "link": null,
      "locked": false,
      "text": "Avoid\n* Avoid using in-line rules with `ingress` and `egress` arguments of the `aws_security_group`\n* Avoid using `aws_security_group_rule` resource.\n",
      "fontSize": 31.83981362076938,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avoid\n* Avoid using in-line rules with `ingress` and `egress` arguments of the `aws_security_group`\n* Avoid using `aws_security_group_rule` resource.\n",
      "autoResize": false,
