    },
    {
      "id": "IGkV6pfyHnj04ts7SEbn4",
      "type": "text",
      "x": -766.3306310062331,
      "y": 5989.5691459572445,
      "width": 1062.5997314453125,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7Q",
      "roundness": null,
      "seed": 1068184894,
      "version": 751,
      "versionNonce": 746234144,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756949406469,
      "link": null,
      "locked": false,
      "text": "from_port = -1, to_port = -1\n\n* Allows ALL ICMP types and codes\n* This includes ping, but also traceroute, destination unreachable, \n  time exceeded, redirect messages, and many other ICMP message types\n* Less secure because it permits more ICMP traffic than just ping",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from_port = -1, to_port = -1\n\n* Allows ALL ICMP types and codes\n* This includes ping, but also traceroute, destination unreachable, \n  time exceeded, redirect messages, and many other ICMP message types\n* Less secure because it permits more ICMP traffic than just ping",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "3kmUyLZpMkNChYOvZW5G0",
      "type": "text",
      "x": 438.6172945883129,
      "y": 6002.046360897201,
      "width": 1062.5997314453125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7R",
      "roundness": null,
      "seed": 1190864674,
      "version": 846,
      "versionNonce": 1120501024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756949406469,
      "link": null,
      "locked": false,
      "text": " from_port = 8, to_port = 0\n\n* Allows only ICMP Type 8, Code 0 (Echo Request - outbound ping)\n* This is specifically for ping requests going OUT from your resource",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " from_port = 8, to_port = 0\n\n* Allows only ICMP Type 8, Code 0 (Echo Request - outbound ping)\n* This is specifically for ping requests going OUT from your resource",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
