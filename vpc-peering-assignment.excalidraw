      "text": "# aws_ec2_transit_gateway.main_tgw:\nresource \"aws_ec2_transit_gateway\" \"main_tgw\" {\n    amazon_side_asn                    = 64512\n    arn                                = \"arn:aws:ec2:ap-southeast-1:967622094243:transit-gateway/tgw-00b10a2e0def23970\"\n    association_default_route_table_id = null\n    auto_accept_shared_attachments     = \"disable\"\n    default_route_table_association    = \"disable\"\n    default_route_table_propagation    = \"disable\"\n    description                        = \"Main Transit Gateway for centralized outbound routing\"\n    dns_support                        = \"enable\"\n    id                                 = \"tgw-00b10a2e0def23970\"\n    multicast_support                  = \"disable\"\n    owner_id                           = \"967622094243\"\n    propagation_default_route_table_id = null\n    region                             = \"ap-southeast-1\"\n    security_group_referencing_support = \"disable\"\n    tags                               = {\n        \"Environment\" = \"dev\"\n        \"Name\"        = \"main-tgw\"\n    }\n    tags_all                           = {\n        \"Environment\" = \"dev\"\n        \"Name\"        = \"main-tgw\"\n    }\n    vpn_ecmp_support                   = \"enable\"\n}",
      "fontSize": 28.700201475858808,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# aws_ec2_transit_gateway.main_tgw:\nresource \"aws_ec2_transit_gateway\" \"main_tgw\" {\n    amazon_side_asn                    = 64512\n    arn                                = \"arn:aws:ec2:ap-southeast-1:967622094243:transit-gateway/tgw-00b10a2e0def23970\"\n    association_default_route_table_id = null\n    auto_accept_shared_attachments     = \"disable\"\n    default_route_table_association    = \"disable\"\n    default_route_table_propagation    = \"disable\"\n    description                        = \"Main Transit Gateway for centralized outbound routing\"\n    dns_support                        = \"enable\"\n    id                                 = \"tgw-00b10a2e0def23970\"\n    multicast_support                  = \"disable\"\n    owner_id                           = \"967622094243\"\n    propagation_default_route_table_id = null\n    region                             = \"ap-southeast-1\"\n    security_group_referencing_support = \"disable\"\n    tags                               = {\n        \"Environment\" = \"dev\"\n        \"Name\"        = \"main-tgw\"\n    }\n    tags_all                           = {\n        \"Environment\" = \"dev\"\n        \"Name\"        = \"main-tgw\"\n    }\n    vpn_ecmp_support                   = \"enable\"\n}",
