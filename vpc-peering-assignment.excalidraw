      "seed": 1450591604,
      "version": 498,
      "versionNonce": 1514061556,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1758334171618,
      "link": null,
      "locked": false,
      "text": "* In the given architecture, the Transit Gateway (TGW) is created in the Hub VPC's AWS account, \n  but it is not directly deployed \"inside\" any VPC—TGWs are AWS global network resources that exist at the account and region level, \n  independent of any specific VPC.",
      "fontSize": 36.5658736239779,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* In the given architecture, the Transit Gateway (TGW) is created in the Hub VPC's AWS account, \n  but it is not directly deployed \"inside\" any VPC—TGWs are AWS global network resources that exist at the account and region level, \n  independent of any specific VPC.",
