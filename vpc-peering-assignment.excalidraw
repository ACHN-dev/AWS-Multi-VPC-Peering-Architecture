      "text": "resource \"aws_ec2_transit_gateway\" \"main_tgw\" {\n  description                     = \"Main Transit Gateway for centralized outbound routing\"\n  default_route_table_association = \"disable\"\n  default_route_table_propagation = \"disable\"\n\n  tags = {\n    Name        = \"main-tgw\"\n    Environment = \"dev\"\n  }\n}",
