    {
      "id": "0caX64_0CUMg1TRzw2L7W",
      "type": "text",
      "x": -8790.205798047748,
      "y": 11183.273471516048,
      "width": 3941.782958984375,
      "height": 355.55804563233755,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQ7",
      "roundness": null,
      "seed": 1302296175,
      "version": 385,
      "versionNonce": 875944673,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "WyW1wkoGBQ8ILL3MxCYn4",
          "type": "arrow"
        }
      ],
      "updated": 1757423989709,
      "link": null,
      "locked": false,
      "text": "1. No Inbound Ports: The instance doesn’t require SSH port (22) open. All traffic is outbound to AWS VPC endpoint via tcp/443.\n\n2. Encrypted: Data is encrypted via WebSocket (TLS) and IAM-authorized.\n\n3. Auditable: AWS CloudTrail logs the session start/end times and users.",
      "fontSize": 56.88928730117401,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. No Inbound Ports: The instance doesn’t require SSH port (22) open. All traffic is outbound to AWS VPC endpoint via tcp/443.\n\n2. Encrypted: Data is encrypted via WebSocket (TLS) and IAM-authorized.\n\n3. Auditable: AWS CloudTrail logs the session start/end times and users.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
