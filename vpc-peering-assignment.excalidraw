      "text": "resource \"aws_ec2_transit_gateway_vpc_attachment\" \"hub_vpc_attachment\" {\n  subnet_ids         = [aws_subnet.hub_private_subnet01.id]\n  transit_gateway_id = aws_ec2_transit_gateway.main_tgw.id\n  vpc_id             = aws_vpc.hub_vpc.id\n\n  tags = {\n    Name = \"hub-vpc-tgw-attachment\"\n  }\n}",
