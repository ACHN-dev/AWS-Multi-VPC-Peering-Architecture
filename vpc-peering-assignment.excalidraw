    {
      "id": "0js-pFzwyJX8UGYLPY6nY",
      "type": "text",
      "x": -643.9313244153346,
      "y": 5464.843063065387,
      "width": 2107.7677970075874,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7N",
      "roundness": null,
      "seed": 2075615358,
      "version": 3750,
      "versionNonce": 801705248,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756949406469,
      "link": null,
      "locked": false,
      "text": "Recommendation for same-region vpc peering\n* For same-region vpc peering, recommend to use security group references rather than CIDR blocks when possible.\n\nWhen to use CIDR blocks instead\n* You cannot reference the security group of a peer VPC that's in a different Region. Instead, use the CIDR blocks of the peer VPC.\n* Use CIDR blocks in Cross-Account Scenarios",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recommendation for same-region vpc peering\n* For same-region vpc peering, recommend to use security group references rather than CIDR blocks when possible.\n\nWhen to use CIDR blocks instead\n* You cannot reference the security group of a peer VPC that's in a different Region. Instead, use the CIDR blocks of the peer VPC.\n* Use CIDR blocks in Cross-Account Scenarios",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
