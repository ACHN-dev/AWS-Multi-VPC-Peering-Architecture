    {
      "id": "eHjMdvInVwvWvURSVtbrK",
      "type": "text",
      "x": -13027.040972632976,
      "y": 12163.635487238083,
      "width": 3588.9697265625,
      "height": 582.667841205621,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bRE",
      "roundness": null,
      "seed": 702500240,
      "version": 92,
      "versionNonce": 411217264,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757654633506,
      "link": null,
      "locked": false,
      "text": "AWS Systems Manager is integrated with AWS CloudTrail, a service that provides a record of actions taken by a user, role, or an AWS service.\nEvery event or log entry contains information about who generated the request. The identity information helps you determine the following:\n\n* Whether the request was made with root user or user credentials.\n\n* Whether the request was made on behalf of an IAM Identity Center user.\n\n* Whether the request was made with temporary security credentials for a role or federated user.\n\n* Whether the request was made by another AWS service.",
      "fontSize": 46.613427296449686,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS Systems Manager is integrated with AWS CloudTrail, a service that provides a record of actions taken by a user, role, or an AWS service.\nEvery event or log entry contains information about who generated the request. The identity information helps you determine the following:\n\n* Whether the request was made with root user or user credentials.\n\n* Whether the request was made on behalf of an IAM Identity Center user.\n\n* Whether the request was made with temporary security credentials for a role or federated user.\n\n* Whether the request was made by another AWS service.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
