      "index": "b7H",
      "roundness": null,
      "seed": 124061154,
      "version": 392,
      "versionNonce": 1898299680,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756949406469,
      "link": null,
      "locked": false,
      "text": "resource \"aws_security_group\" \"fe_private_sg01\" {\n  name = \"${var.frontend_prefix}-private-security-group01\"\n\n  vpc_id = aws_vpc.frontend_vpc.id\n\n  tags = {\n    Name = \"${var.frontend_prefix}-private-security-group01\"\n  }\n}\n\nresource \"aws_vpc_security_group_ingress_rule\" \"fe_private_sg01_allow_ssh\" {\n  security_group_id            = aws_security_group.fe_private_sg01.id\n  referenced_security_group_id = aws_security_group.fe_public_sg01.id\n  from_port                    = 22\n  ip_protocol                  = \"tcp\"\n  to_port                      = 22\n}\n\nresource \"aws_vpc_security_group_ingress_rule\" \"fe_private_sg01_allow_icmp\" {\n  security_group_id            = aws_security_group.fe_private_sg01.id\n  referenced_security_group_id = aws_security_group.fe_public_sg01.id\n  from_port                    = 8\n  ip_protocol                  = \"icmp\"\n  to_port                      = 0\n}\n\nresource \"aws_vpc_security_group_egress_rule\" \"fe_private_sg01_allow_all_traffic\" {\n  security_group_id = aws_security_group.fe_private_sg01.id\n  cidr_ipv4         = \"0.0.0.0/0\"\n  ip_protocol       = \"-1\" # semantically equivalent to all ports\n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "resource \"aws_security_group\" \"fe_private_sg01\" {\n  name = \"${var.frontend_prefix}-private-security-group01\"\n\n  vpc_id = aws_vpc.frontend_vpc.id\n\n  tags = {\n    Name = \"${var.frontend_prefix}-private-security-group01\"\n  }\n}\n\nresource \"aws_vpc_security_group_ingress_rule\" \"fe_private_sg01_allow_ssh\" {\n  security_group_id            = aws_security_group.fe_private_sg01.id\n  referenced_security_group_id = aws_security_group.fe_public_sg01.id\n  from_port                    = 22\n  ip_protocol                  = \"tcp\"\n  to_port                      = 22\n}\n\nresource \"aws_vpc_security_group_ingress_rule\" \"fe_private_sg01_allow_icmp\" {\n  security_group_id            = aws_security_group.fe_private_sg01.id\n  referenced_security_group_id = aws_security_group.fe_public_sg01.id\n  from_port                    = 8\n  ip_protocol                  = \"icmp\"\n  to_port                      = 0\n}\n\nresource \"aws_vpc_security_group_egress_rule\" \"fe_private_sg01_allow_all_traffic\" {\n  security_group_id = aws_security_group.fe_private_sg01.id\n  cidr_ipv4         = \"0.0.0.0/0\"\n  ip_protocol       = \"-1\" # semantically equivalent to all ports\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "fDyy7LX8nS3KHrMT0vzxE",
      "type": "text",
      "x": -1165.2941820612623,
      "y": 4048.848423652572,
      "width": 1278.1995849609375,
      "height": 1295,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7I",
      "roundness": null,
      "seed": 646146338,
      "version": 374,
      "versionNonce": 84974880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756949406469,
      "link": null,
      "locked": false,
      "text": "resource \"aws_security_group\" \"fe_private_sg01\" {\n  name        = \"${var.frontend_prefix}-private-security-group01\"\n  description = \"Private SG allowing SSH + ICMP from public SG, all egress allowed\"\n  vpc_id      = aws_vpc.frontend_vpc.id\n\n  # Allow SSH from the public security group\n  ingress {\n    description              = \"Allow SSH from public SG\"\n    from_port                = 22\n    to_port                  = 22\n    protocol                 = \"tcp\"\n    security_groups          = [aws_security_group.fe_public_sg01.id]\n  }\n\n  # Allow ICMP (ping) from the public security group\n  ingress {\n    description              = \"Allow ICMP ping from public SG\"\n    from_port                = 8          # ICMP type 8 = Echo Request\n    to_port                  = 0          # Code 0 = Echo Reply\n    protocol                 = \"icmp\"\n    security_groups          = [aws_security_group.fe_public_sg01.id]\n  }\n\n  # Allow all outbound traffic\n  egress {\n    description = \"Allow all egress\"\n    from_port   = 0\n    to_port     = 0\n    protocol    = \"-1\"\n    cidr_blocks = [\"0.0.0.0/0\"]\n  }\n\n  tags = {\n    Name = \"${var.frontend_prefix}-private-security-group01\"\n  }\n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "resource \"aws_security_group\" \"fe_private_sg01\" {\n  name        = \"${var.frontend_prefix}-private-security-group01\"\n  description = \"Private SG allowing SSH + ICMP from public SG, all egress allowed\"\n  vpc_id      = aws_vpc.frontend_vpc.id\n\n  # Allow SSH from the public security group\n  ingress {\n    description              = \"Allow SSH from public SG\"\n    from_port                = 22\n    to_port                  = 22\n    protocol                 = \"tcp\"\n    security_groups          = [aws_security_group.fe_public_sg01.id]\n  }\n\n  # Allow ICMP (ping) from the public security group\n  ingress {\n    description              = \"Allow ICMP ping from public SG\"\n    from_port                = 8          # ICMP type 8 = Echo Request\n    to_port                  = 0          # Code 0 = Echo Reply\n    protocol                 = \"icmp\"\n    security_groups          = [aws_security_group.fe_public_sg01.id]\n  }\n\n  # Allow all outbound traffic\n  egress {\n    description = \"Allow all egress\"\n    from_port   = 0\n    to_port     = 0\n    protocol    = \"-1\"\n    cidr_blocks = [\"0.0.0.0/0\"]\n  }\n\n  tags = {\n    Name = \"${var.frontend_prefix}-private-security-group01\"\n  }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "1e6NeGi3DKbRSwK76mGRM",
