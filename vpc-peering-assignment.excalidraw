    {
      "id": "jIRIyt3DGhOGXiRGxZNry",
      "type": "text",
      "x": 1183.1276029364972,
      "y": 11359.783751360872,
      "width": 1983.6645503235502,
      "height": 330.4052168285696,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHX",
      "roundness": null,
      "seed": 46192864,
      "version": 3031,
      "versionNonce": 976505120,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1756796309863,
      "link": null,
      "locked": false,
      "text": "\n\nOutbound Rules\n* Allow 8080(TCP) traffic to the `internal_server_sg` # this is important, \"Access to internal web service for port forwarding\"\n\n* Allow SSH traffic to the destination 10.0.0.0/16 (var.frontend_vpc_address_space) or specific `internal_server_sg` id\n\n* Allow 443(HTTPS) traffic to the destination 0.0.0.0/0 # package updates\n\n* Allow 80(HTTP) traffic to the destination 0.0.0.0/0 # package updates\n",
      "fontSize": 24.029470314805067,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nOutbound Rules\n* Allow 8080(TCP) traffic to the `internal_server_sg` # this is important, \"Access to internal web service for port forwarding\"\n\n* Allow SSH traffic to the destination 10.0.0.0/16 (var.frontend_vpc_address_space) or specific `internal_server_sg` id\n\n* Allow 443(HTTPS) traffic to the destination 0.0.0.0/0 # package updates\n\n* Allow 80(HTTP) traffic to the destination 0.0.0.0/0 # package updates\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
