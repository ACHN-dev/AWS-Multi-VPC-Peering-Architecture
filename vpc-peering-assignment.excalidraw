      "boundElements": [],
      "updated": 1756949617770,
      "link": null,
      "locked": false,
      "text": "AWS + HashiCorp's Recommendation \n* Use separate `aws_vpc_security_group_ingress_rule` and `aws_vpc_security_group_egress_rule`\nresources, and reference to `aws_security_group`",
      "fontSize": 31.83981362076938,
