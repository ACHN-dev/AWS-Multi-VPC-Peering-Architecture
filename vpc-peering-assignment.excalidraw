      "height": 7070,
      "angle": 0,
      "strokeColor": "#38d9a9",
      "backgroundColor": "#96f2d7",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
