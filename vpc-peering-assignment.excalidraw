      "seed": 2100065568,
      "version": 21,
      "versionNonce": 1607365856,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1756796309863,
      "link": null,
      "locked": false,
      "text": "# Basic network tools for Amazon Linux\nsudo yum update -y\nsudo yum install -y \\\n    net-tools \\          # netstat, ifconfig, route\n    lsof \\               # List open files/ports\n    tcpdump \\            # Packet capture\n    nmap \\               # Network scanning\n    telnet \\             # Test connections\n    curl \\               # HTTP client\n    wget \\               # Download tool\n    bind-utils \\         # dig, nslookup (instead of dnsutils)\n    iproute \\            # ip command\n    iptables \\           # Firewall rules\n    htop \\               # Process monitor\n    tree \\               # Directory tree\n    vim                  # Text editor",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Basic network tools for Amazon Linux\nsudo yum update -y\nsudo yum install -y \\\n    net-tools \\          # netstat, ifconfig, route\n    lsof \\               # List open files/ports\n    tcpdump \\            # Packet capture\n    nmap \\               # Network scanning\n    telnet \\             # Test connections\n    curl \\               # HTTP client\n    wget \\               # Download tool\n    bind-utils \\         # dig, nslookup (instead of dnsutils)\n    iproute \\            # ip command\n    iptables \\           # Firewall rules\n    htop \\               # Process monitor\n    tree \\               # Directory tree\n    vim                  # Text editor",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "7UwhtUdzy1W2jNQrfZzV4",
      "type": "text",
      "x": 5740.791915768023,
      "y": 12323.476196251597,
      "width": 2633.39892578125,
      "height": 735,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIa",
      "roundness": null,
      "seed": 879997152,
      "version": 6,
      "versionNonce": 573032736,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1756796309863,
      "link": null,
      "locked": false,
      "text": "  # User data script to set up the bastion host\n    user_data = <<-EOF\n                #!/bin/bash\n                yum update -y\n                yum install -y htop net-tools\n\n                # Create a simple script to help with SSH forwarding\n                cat > /home/ec2-user/ssh-forward-help.txt << 'SCRIPT'\n  # SSH Port Forwarding Examples:\n\n  # 1. Local Port Forwarding (access internal service from your local machine):\n  ssh -i ${aws_key_pair.fe_keypair.key_name} -L 8080:${aws_instance.frontend_private_instance01.private_ip}:8080 ec2-user@${aws_eip.frontend_public_instance_eip.public_ip}\n\n  # 2. Dynamic Port Forwarding (SOCKS proxy):\n  ssh -i ${aws_key_pair.fe_keypair.key_name} -D 1080 ec2-user@${aws_eip.frontend_public_instance_eip.public_ip}\n\n  # 3. SSH to private instance through bastion:\n  ssh -i ${aws_key_pair.fe_keypair.key_name} -J ec2-user@${aws_eip.frontend_public_instance_eip.public_ip} ubuntu@${aws_instance.frontend_private_instance01.private_ip}\n  SCRIPT\n                chown ec2-user:ec2-user /home/ec2-user/ssh-forward-help.txt\n                EOF",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  # User data script to set up the bastion host\n    user_data = <<-EOF\n                #!/bin/bash\n                yum update -y\n                yum install -y htop net-tools\n\n                # Create a simple script to help with SSH forwarding\n                cat > /home/ec2-user/ssh-forward-help.txt << 'SCRIPT'\n  # SSH Port Forwarding Examples:\n\n  # 1. Local Port Forwarding (access internal service from your local machine):\n  ssh -i ${aws_key_pair.fe_keypair.key_name} -L 8080:${aws_instance.frontend_private_instance01.private_ip}:8080 ec2-user@${aws_eip.frontend_public_instance_eip.public_ip}\n\n  # 2. Dynamic Port Forwarding (SOCKS proxy):\n  ssh -i ${aws_key_pair.fe_keypair.key_name} -D 1080 ec2-user@${aws_eip.frontend_public_instance_eip.public_ip}\n\n  # 3. SSH to private instance through bastion:\n  ssh -i ${aws_key_pair.fe_keypair.key_name} -J ec2-user@${aws_eip.frontend_public_instance_eip.public_ip} ubuntu@${aws_instance.frontend_private_instance01.private_ip}\n  SCRIPT\n                chown ec2-user:ec2-user /home/ec2-user/ssh-forward-help.txt\n                EOF",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
