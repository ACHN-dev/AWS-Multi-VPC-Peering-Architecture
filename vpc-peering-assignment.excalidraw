      "seed": 186916064,
      "version": 15,
      "versionNonce": 1286761760,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1756796309863,
      "link": null,
      "locked": false,
      "text": "# Basic network tools for Ubuntu\nsudo apt-get update\nsudo apt-get install -y \\\n    net-tools \\          # netstat, ifconfig, route\n    ss \\                 # Modern replacement for netstat\n    lsof \\               # List open files/ports\n    tcpdump \\            # Packet capture\n    nmap \\               # Network scanning\n    telnet \\             # Test connections\n    curl \\               # HTTP client\n    wget \\               # Download tool\n    dnsutils \\           # dig, nslookup\n    iproute2 \\           # ip command\n    iptables \\           # Firewall rules\n    htop \\               # Process monitor\n    tree \\               # Directory tree\n    vim                  # Text editor",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Basic network tools for Ubuntu\nsudo apt-get update\nsudo apt-get install -y \\\n    net-tools \\          # netstat, ifconfig, route\n    ss \\                 # Modern replacement for netstat\n    lsof \\               # List open files/ports\n    tcpdump \\            # Packet capture\n    nmap \\               # Network scanning\n    telnet \\             # Test connections\n    curl \\               # HTTP client\n    wget \\               # Download tool\n    dnsutils \\           # dig, nslookup\n    iproute2 \\           # ip command\n    iptables \\           # Firewall rules\n    htop \\               # Process monitor\n    tree \\               # Directory tree\n    vim                  # Text editor",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "1mO2oAdAk93WyknHKi3Is",
      "type": "text",
      "x": 6369.833650742772,
      "y": 11253.9065025895,
      "width": 954.7996826171875,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
