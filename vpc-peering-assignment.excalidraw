      "text": "Inbound Rules\n* Allow 0.0.0.0/0 to be able to SSH to bastion-host",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inbound Rules\n* Allow 0.0.0.0/0 to be able to SSH to bastion-host",
